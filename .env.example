# ==============================================================================
# Job_Seek Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your real Gemini API key:
#   cp .env.example .env
#
# NEVER commit your .env file or real API keys to GitHub!
# ==============================================================================

# Gemini API Configuration (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY="Gemini API goes here"

# Recommended Google Gemini models with high RPM and generous free quotas
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_PRO_MODEL=gemini-3.1-flash-lite

# Alternative LLM Providers (Optional - leave commented or blank if using Gemini)
# OPENAI_API_KEY="OpenAI API key goes here (optional)"
# OLLAMA_ENDPOINT=http://localhost:11434

# System Scoring & Verification Thresholds
MIN_RELEVANCE_SCORE=50
PRECISION_TARGET=0.85
DEAD_LINK_MAX=0.05
SAMPLE_AUDIT_RATE=0.20

# Budgets & Rate Limits
MAX_LLM_CALLS=500
MAX_TOKENS=1000000
MAX_RUNTIME_SECONDS=3600
MAX_HTTP_REQUESTS=5000
GLOBAL_CONCURRENCY=8
PER_HOST_CONCURRENCY=2

# Bot Identity
USER_AGENT=JobSeekBot/2.0 (+https://github.com/example/job_seek)
